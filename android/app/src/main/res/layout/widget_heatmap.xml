<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Row labels -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="18"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Fajr"
            android:textColor="#1A1917"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Dhuhr"
            android:textColor="#1A1917"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Asr"
            android:textColor="#1A1917"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Maghrib"
            android:textColor="#1A1917"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Isha"
            android:textColor="#1A1917"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical" />
    </LinearLayout>

    <!-- Grid area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="82"
        android:orientation="vertical">

        <!-- Column headers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10"
            android:orientation="horizontal">

            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="M" android:textColor="#1A1917" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="T" android:textColor="#1A1917" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="W" android:textColor="#1A1917" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="T" android:textColor="#1A1917" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="F" android:textColor="#1A1917" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="S" android:textColor="#1A1917" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="S" android:textColor="#1A1917" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:gravity="center" />
        </LinearLayout>

        <!-- Row 0: Fajr -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="90"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView android:id="@+id/cell_0_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_0_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_0_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_0_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_0_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_0_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_0_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
        </LinearLayout>

        <!-- Row 1: Dhuhr (cell_1_4 = Friday Dhuhr — gets jumuah underline) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="90"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView android:id="@+id/cell_1_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_1_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_1_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_1_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <!-- Friday Dhuhr — uses layer-list with gold underline -->
            <ImageView android:id="@+id/cell_1_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_jumuah" />
            <ImageView android:id="@+id/cell_1_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_1_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
        </LinearLayout>

        <!-- Row 2: Asr -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="90"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView android:id="@+id/cell_2_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_2_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_2_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_2_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_2_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_2_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_2_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
        </LinearLayout>

        <!-- Row 3: Maghrib -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="90"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView android:id="@+id/cell_3_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_3_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_3_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_3_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_3_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_3_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_3_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
        </LinearLayout>

        <!-- Row 4: Isha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="90"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView android:id="@+id/cell_4_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_4_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_4_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_4_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_4_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_4_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
            <ImageView android:id="@+id/cell_4_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:scaleType="fitXY" android:src="@drawable/cell_unlogged" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
