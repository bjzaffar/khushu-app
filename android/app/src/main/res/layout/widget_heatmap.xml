<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#FFFFFFFF">

    <!-- Column Headers (Day Labels) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Empty space for row label -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1.8"
            android:text="" />

        <!-- Day labels: M T W T F S S -->
        <TextView
            android:id="@+id/header_m"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="M"
            android:textColor="#FF1A1917"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/header_t1"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="T"
            android:textColor="#FF1A1917"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/header_w"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="W"
            android:textColor="#FF1A1917"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/header_t2"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="T"
            android:textColor="#FF1A1917"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/header_f"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="F"
            android:textColor="#FF1A1917"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/header_s1"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="S"
            android:textColor="#FF1A1917"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/header_s2"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="S"
            android:textColor="#FF1A1917"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 1: Fajr -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1.8"
            android:gravity="end|center_vertical"
            android:paddingEnd="4dp"
            android:text="Fajr"
            android:textColor="#FF1A1917"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View android:id="@+id/cell_fajr_0" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_fajr_1" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_fajr_2" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_fajr_3" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_fajr_4" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_fajr_5" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_fajr_6" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
    </LinearLayout>

    <!-- Row 2: Dhuhr -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1.8"
            android:gravity="end|center_vertical"
            android:paddingEnd="4dp"
            android:text="Dhuhr"
            android:textColor="#FF1A1917"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View android:id="@+id/cell_dhuhr_0" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_dhuhr_1" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_dhuhr_2" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_dhuhr_3" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_dhuhr_4" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_dhuhr_5" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_dhuhr_6" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
    </LinearLayout>

    <!-- Row 3: Asr -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1.8"
            android:gravity="end|center_vertical"
            android:paddingEnd="4dp"
            android:text="Asr"
            android:textColor="#FF1A1917"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View android:id="@+id/cell_asr_0" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_asr_1" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_asr_2" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_asr_3" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_asr_4" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_asr_5" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_asr_6" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
    </LinearLayout>

    <!-- Row 4: Maghrib -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1.8"
            android:gravity="end|center_vertical"
            android:paddingEnd="4dp"
            android:text="Maghrib"
            android:textColor="#FF1A1917"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View android:id="@+id/cell_maghrib_0" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_maghrib_1" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_maghrib_2" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_maghrib_3" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_maghrib_4" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_maghrib_5" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_maghrib_6" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
    </LinearLayout>

    <!-- Row 5: Isha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1.8"
            android:gravity="end|center_vertical"
            android:paddingEnd="4dp"
            android:text="Isha"
            android:textColor="#FF1A1917"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View android:id="@+id/cell_isha_0" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_isha_1" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_isha_2" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_isha_3" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_isha_4" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_isha_5" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
        <View android:id="@+id/cell_isha_6" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:background="#FFC5B9A8" />
    </LinearLayout>

</LinearLayout>
