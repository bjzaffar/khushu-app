# Public RevenueCat SDK key for the Android app in this repository.
# Configure the real value in EAS/your CI build environment; do not commit it.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Public RevenueCat SDK key for the iOS app. Configure the real value in the
# iOS EAS build environment after the iOS app has been added in RevenueCat.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# Optional RevenueCat Test Store key for running purchase flows in Expo Go.
# Real Android/iOS store keys are intentionally ignored inside Expo Go.
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=

# Public, HTTPS legal pages shown by the subscription paywall.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://getkhushu.netlify.app/privacy
EXPO_PUBLIC_TERMS_OF_USE_URL=https://getkhushu.netlify.app/terms
